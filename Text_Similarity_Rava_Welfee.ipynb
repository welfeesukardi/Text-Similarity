    "import os\n",
    "import pandas as pd\n",
    "\n",
    "DATA_PATH = 'data/tmdb_preprocessed.csv' if os.path.exists('data/tmdb_preprocessed.csv') else ('tmdb_preprocessed.csv' if os.path.exists('tmdb_preprocessed.csv') else '../data/tmdb_preprocessed.csv')\n",
