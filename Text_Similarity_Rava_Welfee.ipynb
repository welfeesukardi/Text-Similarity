   "source": [
    "### 1.2 Memuat Model Word2Vec & FastText dari Feature Engineering\n",
    "\n",
    "Kita memuat bobot model embedding yang disimpan pada notebook feature engineering (`models/tmdb_word2vec.w2v` dan `models/tmdb_fasttext.fasttext`), kemudian melakukan rata-rata vektor (mean pooling) untuk menghasilkan representasi 100-dimensi per film."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "0e1367dd",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Model Word2Vec berhasil dimuat: 478 vocab, dimensi 100\n",
      "Model FastText berhasil dimuat: 1198 vocab, dimensi 100\n"
     ]
    }
   ],
   "source": [
    "import os\n",
    "import gensim.models\n",
    "from nltk import word_tokenize\n",
    "\n",
    "sentences = [word_tokenize(doc.lower()) for doc in df_pre]\n",
    "\n",
    "w2v_path = os.path.join('models', 'tmdb_word2vec.w2v') if os.path.exists(os.path.join('models', 'tmdb_word2vec.w2v')) else ('tmdb_word2vec.w2v' if os.path.exists('tmdb_word2vec.w2v') else '../models/tmdb_word2vec.w2v')\n",
    "model_w2v = gensim.models.Word2Vec.load(w2v_path)\n",
    "print(f\"Model Word2Vec berhasil dimuat: {len(model_w2v.wv)} vocab, dimensi {model_w2v.vector_size}\")\n",
    "\n",
    "ft_path = os.path.join('models', 'tmdb_fasttext.fasttext') if os.path.exists(os.path.join('models', 'tmdb_fasttext.fasttext')) else ('tmdb_fasttext.fasttext' if os.path.exists('tmdb_fasttext.fasttext') else '../models/tmdb_fasttext.fasttext')\n",
    "model_fasttext = gensim.models.FastText.load(ft_path)\n",
    "print(f\"Model FastText berhasil dimuat: {len(model_fasttext.wv)} vocab, dimensi {model_fasttext.vector_size}\")"
   ]
  },
