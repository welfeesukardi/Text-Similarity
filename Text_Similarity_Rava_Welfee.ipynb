   "source": [
    "## 2. Penerapan: Content-Based Movie Recommender System\n",
    "\n",
    "Sistem rekomendasi berbasis konten (Content-Based Filtering) merekomendasikan item baru yang memiliki kemiripan fitur tertinggi dengan item yang disukai pengguna. Dalam studi kasus ini, kemiripan dihitung antara sinopsis film target dengan seluruh film lain di katalog TMDB."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "4a83cebb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Matriks Cosine Similarity TF-IDF terbentuk berukuran: (298, 298)\n",
      "Matriks Cosine Similarity Word2Vec terbentuk berukuran: (298, 298)\n"
     ]
    }
   ],
   "source": [
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "\n",
    "sim_matrix_tfidf = cosine_similarity(X_tfidf)\n",
    "sim_matrix_w2v = cosine_similarity(X_w2v)\n",
    "sim_matrix_ft = cosine_similarity(X_ft)\n",
    "\n",
    "print(f\"Matriks Cosine Similarity TF-IDF terbentuk berukuran: {sim_matrix_tfidf.shape}\")\n",
    "print(f\"Matriks Cosine Similarity Word2Vec terbentuk berukuran: {sim_matrix_w2v.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "c6cf148b",
   "metadata": {},
   "outputs": [],
   "source": [
    "def recommend_movies_by_title(target_title, sim_matrix, df, top_k=5):\n",
    "    matched = df[df['Title'].str.lower() == target_title.lower()]\n",
    "    if matched.empty:\n",
    "        matched = df[df['Title'].str.lower().str.contains(target_title.lower())]\n",
    "    if matched.empty:\n",
    "        print(f\"Film '{target_title}' tidak ditemukan dalam katalog.\")\n",
    "        return None\n",
    "    \n",
    "    idx = matched.index[0]\n",
    "    found_title = df.loc[idx, 'Title']\n",
    "    \n",
    "    sim_scores = sim_matrix[idx]\n",
    "    sorted_indices = np.argsort(sim_scores)[::-1]\n",
    "    top_indices = [i for i in sorted_indices if i != idx][:top_k]\n",
    "    \n",
    "    results = []\n",
    "    for rank, sim_idx in enumerate(top_indices, 1):\n",
    "        results.append({\n",
    "            'Rank': rank,\n",
    "            'Title': df.loc[sim_idx, 'Title'],\n",
    "            'Similarity': round(float(sim_scores[sim_idx]), 4),\n",
    "            'Vote Average': df.loc[sim_idx, 'Vote Average'],\n",
    "            'Overview Snippet': str(df.loc[sim_idx, 'Overview'])[:120] + '...'\n",
    "        })\n",
    "    \n",
    "    return found_title, pd.DataFrame(results)"
   ]
  },
