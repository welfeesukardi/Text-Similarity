   "source": [
    "## 3. Penerapan: Free-Text Search Query Matching\n",
    "\n",
    "Skenario ini mensimulasikan mesin pencari (search engine): pengguna memasukkan kata kunci bebas (query string), kemudian sistem mengonversi query tersebut ke dalam ruang fitur yang sama dan menghitung kemiripan terhadap seluruh sinopsis film TMDB."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "9a954f7e",
   "metadata": {},
   "outputs": [],
   "source": [
    "from scipy.spatial.distance import cdist\n",
    "\n",
    "def search_movies_by_query(query_text, df, tfidf_vec, bin_vec, model_w2v, top_k=5):\n",
    "    # 1. TF-IDF Vector & Cosine Similarity\n",
    "    q_tfidf = tfidf_vec.transform([query_text])\n",
    "    sim_tfidf = cosine_similarity(X_tfidf, q_tfidf).flatten()\n",
    "    top_idx_tfidf = np.argsort(sim_tfidf)[::-1][:top_k]\n",
    "    \n",
    "    # 2. Binary Vector & Jaccard Similarity\n",
    "    q_bin = bin_vec.transform([query_text]).toarray()\n",
    "    X_bin_arr = X_bin.toarray() if hasattr(X_bin, 'toarray') else X_bin\n",
    "    dist_jaccard = cdist(X_bin_arr, q_bin, metric='jaccard').flatten()\n",
    "    sim_jaccard = 1 - dist_jaccard\n",
    "    top_idx_jaccard = np.argsort(sim_jaccard)[::-1][:top_k]\n",
    "    \n",
    "    # 3. Word2Vec Mean Vector & Cosine Similarity\n",
    "    q_tokens = word_tokenize(query_text.lower())\n",
    "    q_w2v = get_document_vector(q_tokens, model_w2v).reshape(1, -1)\n",
    "    if np.linalg.norm(q_w2v) > 0:\n",
    "        sim_w2v = cosine_similarity(X_w2v, q_w2v).flatten()\n",
    "    else:\n",
    "        sim_w2v = np.zeros(len(df))\n",
    "    top_idx_w2v = np.argsort(sim_w2v)[::-1][:top_k]\n",
    "    \n",
    "    res_tfidf = df.loc[top_idx_tfidf, 'Title'].values\n",
    "    scores_tfidf = [round(float(s), 4) for s in sim_tfidf[top_idx_tfidf]]\n",
    "    \n",
    "    res_jaccard = df.loc[top_idx_jaccard, 'Title'].values\n",
    "    scores_jaccard = [round(float(s), 4) for s in sim_jaccard[top_idx_jaccard]]\n",
    "    \n",
    "    res_w2v = df.loc[top_idx_w2v, 'Title'].values\n",
    "    scores_w2v = [round(float(s), 4) for s in sim_w2v[top_idx_w2v]]\n",
    "    \n",
    "    comp_df = pd.DataFrame({\n",
    "        'Rank': range(1, top_k + 1),\n",
    "        'TF-IDF Movie': res_tfidf,\n",
    "        'TF-IDF Score': scores_tfidf,\n",
    "        'Jaccard Movie': res_jaccard,\n",
    "        'Jaccard Score': scores_jaccard,\n",
    "        'Word2Vec Movie': res_w2v,\n",
    "        'Word2Vec Score': scores_w2v\n",
    "    })\n",
    "    return comp_df"
   ]
  },
