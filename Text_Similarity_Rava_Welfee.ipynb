    "def get_document_vector(tokens, model):\n",
    "    valid_vectors = [model.wv[word] for word in tokens if word in model.wv]\n",
    "    if not valid_vectors:\n",
    "        return np.zeros(model.vector_size)\n",
    "    return np.mean(valid_vectors, axis=0)\n",
    "\n",
    "X_w2v = np.array([get_document_vector(doc, model_w2v) for doc in sentences])\n",
    "X_ft = np.array([get_document_vector(doc, model_fasttext) for doc in sentences])\n",
    "\n",
    "df_w2v = pd.DataFrame(X_w2v)\n",
    "df_ft = pd.DataFrame(X_ft)\n",
    "\n",
    "print(\"Ukuran representasi Word2Vec:\", X_w2v.shape)\n",
    "print(\"Ukuran representasi FastText:\", X_ft.shape)\n",
    "display(df_w2v.head(3))"
   ]
